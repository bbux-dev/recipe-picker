# Copy to .env (gitignored) and fill in. Loaded by direnv via .envrc.
# Used by tools/deploy.sh.

# AWS SSO profile used to deploy
AWS_PROFILE=<your-sso-profile>
# 12-digit AWS account the stack lives in; tools/deploy.sh refuses any other account
MEALPICKER_EXPECTED_AWS_ACCOUNT=<12-digit-aws-account-id>

# Cloudflare token scoped to the bxtn.dev zone: Zone:Zone:Read + Zone:DNS:Edit
CLOUDFLARE_API_TOKEN=<cloudflare-token>
# Cloudflare account id that owns the bxtn.dev zone
CLOUDFLARE_DEFAULT_ACCOUNT_ID=<cloudflare-account-id>
